# 复制为 .env 并填入你的 DeepSeek API Key（https://platform.deepseek.com）
# 不填则进入「模拟模式」，用预设台词回复，方便先看效果
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com
PORT=3000

# 可选：ElevenLabs 自然语音（https://elevenlabs.io → 右下角头像 → API Keys）
# 不填就用浏览器自带语音。音色可以在网页里选，也可以在这里填默认音色 ID
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=eleven_flash_v2_5
